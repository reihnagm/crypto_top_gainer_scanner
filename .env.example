# CoinGecko Demo API key is optional because the public/keyless API can be used.
# Supplying a Demo key usually gives a more predictable personal rate limit.
COINGECKO_API_KEY=

# Telegram: create a bot using @BotFather, then fill these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler: every 30 minutes.
CRON_SCHEDULE=*/30 * * * *
TIMEZONE=Asia/Jakarta
RUN_ONCE=false

# Market universe: adjusted to include coins around rank #1000 such as Akedo.
# 1,500 ranks = 6 API pages, because CoinGecko returns up to 250 coins per page.
MAX_MARKET_RANK=1500
TOP_LIMIT=30
MIN_24H_CHANGE=5
MIN_MARKET_CAP=5000000
MIN_VOLUME=1000000
PAGE_DELAY_MS=700

# Momentum/scoring.
MIN_APPEARANCES=3
VOLUME_GROWTH_PERCENT=5
EXTREME_PUMP_PERCENT=40
ALERT_SCORE=5
MAX_VOLUME_TO_MARKET_CAP_PERCENT=300

# Prevent Telegram spam.
ALERT_COOLDOWN_MINUTES=180
MAX_ALERTS_PER_RUN=5

# Comma-separated symbols or CoinGecko IDs to ignore.
EXCLUDED_SYMBOLS=
EXCLUDED_IDS=

# Storage.
STATE_FILE=./data/state.json
HISTORY_RETENTION_DAYS=7
